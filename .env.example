# Copy this file to .env and fill in real values. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- MySQL (shared by the Inngest translation pipeline and the dashboard backend) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=i18n
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=i18n_translator
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Inngest (self-hosted dev server) ---
# Dashboard/UI for watching runs, retries, and concurrency at http://localhost:8288
INNGEST_PORT=8288

# --- Dashboard backend ---
DASHBOARD_BACKEND_PORT=8000
# Where the dashboard backend writes exported translation JSON files (mounted volume, shared with the Inngest export step)
EXPORT_OUTPUT_DIR=/data/output

# --- Dashboard frontend ---
VITE_API_BASE_URL=http://localhost:8000
DASHBOARD_FRONTEND_PORT=5173
